<Window x:Class="TypeFix.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TypeFix"
        Title="TypeFix"
        Width="1080"
        Height="760"
        MinWidth="980"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Loaded="Window_Loaded">

    <Grid>
    <Border x:Name="Shell"
            Margin="20"
            CornerRadius="16"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderThickness="1"
            BorderBrush="#2A3C58"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="8"
                              Opacity="0.55"
                              Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5B8CFF" Offset="0"/>
                                <GradientStop Color="#7A5CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Viewbox Width="16" Height="16" Margin="6">
                            <Canvas Width="16" Height="16">
                                <Rectangle Canvas.Left="0.5" Canvas.Top="0.5" Width="8.5" Height="8.5"
                                           RadiusX="1.6" RadiusY="1.6" Fill="White"/>
                                <Rectangle Canvas.Left="6" Canvas.Top="6" Width="9.2" Height="9.2"
                                           RadiusX="1.8" RadiusY="1.8"
                                           Stroke="White" StrokeThickness="1.35" Fill="#33FFFFFF"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="TypeFix"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="ExtraBold"
                               Margin="10,0,0,0"/>
                    <TextBlock Text="{DynamicResource Subtitle}"
                               VerticalAlignment="Center"
                               FontSize="12.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <Rectangle Grid.Column="0"
                           Fill="Transparent"
                           MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="1"
                            Panel.ZIndex="1"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">
                    <Button Style="{StaticResource TitleBarButton}"
                            ToolTip="{DynamicResource TooltipMinimize}"
                            Click="MinimizeButton_Click">
                        <TextBlock Text="&#xE921;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="{DynamicResource TooltipMaximize}"
                            Click="MaximizeButton_Click">
                        <TextBlock x:Name="MaximizeGlyph"
                                   Text="&#xE922;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource CloseButton}"
                            ToolTip="{DynamicResource TooltipClose}"
                            Click="CloseButton_Click">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>

                <Border Height="1"
                        VerticalAlignment="Bottom"
                        Background="#162033"
                        Grid.ColumnSpan="2"/>
            </Grid>

            <Grid x:Name="ContentRoot" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="188"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="318"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderBrush="#182338"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,14,0,0">
                            <RadioButton x:Name="NavGeneral"
                                         GroupName="MainNav"
                                         IsChecked="True"
                                         Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="{DynamicResource NavGeneral}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavTry"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="{DynamicResource NavTry}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="{DynamicResource NavSettings}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAbout"
                                         GroupName="MainNav"
                                         Style="{StaticResource NavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                    <TextBlock Text="{DynamicResource NavAbout}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    Margin="18,0,12,16"
                                    VerticalAlignment="Center">
                            <TextBlock Text="&#xE72D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource SidebarFooter}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Center pages -->
                <Grid Grid.Column="1" Margin="22,18,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="PagesHost">
                        <!-- General -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavGeneral}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ScrollViewer Style="{StaticResource PageScrollViewer}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE80F;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource AccentBrushLight}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource NavGeneral}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource GeneralLead}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16"/>

                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,10"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xEA80;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="#F5C542"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{DynamicResource GeneralHotkey}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                        <Border Grid.Column="2"
                                                Background="#10182A"
                                                BorderBrush="#2C3E58"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,5"
                                                MinWidth="52">
                                            <TextBlock Text="F10"
                                                       FontWeight="SemiBold"
                                                       FontSize="12.5"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <local:LayoutManagerControl x:Name="GeneralLayouts"
                                                            ShowManagement="False"
                                                            Margin="0,0,0,10"/>

                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource GeneralTrayTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource GeneralTrayBody}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Try -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavTry}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE768;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource AccentBrushLight}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource NavTry}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource TryLead}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="2,0,2,6">
                                <TextBlock Text="{DynamicResource TryOriginal}"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="{DynamicResource TooltipClearNotes}"
                                        Click="TryClearButton_Click">
                                    <TextBlock Text="&#xE74D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,0,0,10" Height="108">
                                <TextBox x:Name="TryInputBox"
                                         Style="{StaticResource NoteTextBox}"
                                         TextChanged="TryInputBox_TextChanged"
                                         PreviewKeyDown="TryInputBox_PreviewKeyDown"/>
                                <TextBlock x:Name="TryInputPlaceholder"
                                           Text="{DynamicResource TryPlaceholder}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="13.5"
                                           Margin="14,12,14,0"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Top"/>
                            </Grid>

                            <Grid Grid.Row="3" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="TryConvertButton"
                                        Style="{StaticResource PrimaryButton}"
                                        MinWidth="0"
                                        ToolTip="{DynamicResource TooltipConvert}"
                                        Click="TryConvertButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA80;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Foreground="White"/>
                                        <TextBlock Text="{DynamicResource TryConvert}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2"
                                        x:Name="TrySwitchButton"
                                        Style="{StaticResource SecondaryButton}"
                                        MinWidth="0"
                                        ToolTip="{DynamicResource TooltipSwitch}"
                                        Click="TrySwitchButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8AB;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{DynamicResource TrySwitch}"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="4" Margin="2,0,2,6">
                                <TextBlock Text="{DynamicResource TryConverted}"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"/>
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="{DynamicResource TooltipCopyResult}"
                                        Click="TryCopyButton_Click">
                                    <TextBlock Text="&#xE8C8;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>

                            <Grid Grid.Row="5" Height="108">
                                <TextBox x:Name="TryOutputBox"
                                         Style="{StaticResource NoteTextBox}"
                                         IsReadOnly="True"
                                         IsReadOnlyCaretVisible="True"
                                         TextChanged="TryOutputBox_TextChanged"/>
                                <TextBlock x:Name="TryOutputPlaceholder"
                                           Text="{DynamicResource TryOutputPlaceholder}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="13.5"
                                           Margin="14,12,14,0"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Grid>

                        <!-- Settings -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavSettings}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ScrollViewer Style="{StaticResource PageScrollViewer}">
                            <StackPanel x:Name="SettingsBody">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE713;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource AccentBrushLight}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource NavSettings}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource SettingsLead}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16"/>

                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,12"
                                        Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="10"
                                                Background="#10283C" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE774;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource AccentBrushLight}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SettingsLanguageTitle}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13.5"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{DynamicResource SettingsLanguageBody}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ComboBox x:Name="LanguageCombo"
                                                  Grid.Column="2"
                                                  Style="{StaticResource DarkComboBox}"
                                                  MinWidth="168"
                                                  VerticalAlignment="Center"
                                                  DisplayMemberPath="NativeName"
                                                  SelectedValuePath="Code"
                                                  SelectionChanged="LanguageCombo_SelectionChanged"/>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,12"
                                        Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="10"
                                                Background="#10283C" VerticalAlignment="Center">
                                            <Viewbox Width="16" Height="16">
                                                <Canvas Width="16" Height="16">
                                                    <Rectangle Width="7" Height="7" Fill="#47C8FF" RadiusX="0.4" RadiusY="0.4"/>
                                                    <Rectangle Canvas.Left="9" Width="7" Height="7" Fill="#47C8FF" RadiusX="0.4" RadiusY="0.4"/>
                                                    <Rectangle Canvas.Top="9" Width="7" Height="7" Fill="#47C8FF" RadiusX="0.4" RadiusY="0.4"/>
                                                    <Rectangle Canvas.Left="9" Canvas.Top="9" Width="7" Height="7" Fill="#47C8FF" RadiusX="0.4" RadiusY="0.4"/>
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SettingsStartupTitle}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13.5"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{DynamicResource SettingsStartupBody}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ToggleButton x:Name="StartupToggle"
                                                      Grid.Column="2"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      VerticalAlignment="Center"
                                                      Checked="StartupToggle_Changed"
                                                      Unchecked="StartupToggle_Changed"/>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE71D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource SettingsLayoutTitle}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource SettingsLayoutLead}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>

                                <local:LayoutManagerControl x:Name="SettingsLayouts"/>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- About -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=NavAbout}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ScrollViewer Style="{StaticResource PageScrollViewer}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="&#xE946;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource AccentBrushLight}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource NavAbout}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource AboutLead}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16"/>

                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,12"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource AboutStep1Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource AboutStep1Body}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,12"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource AboutStep2Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource AboutStep2Body}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource AboutStep3Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource AboutStep3Body}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="0,3,0,0"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{DynamicResource AboutGuideTitle}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,16,0,8"/>
                                <TextBlock Text="{DynamicResource AboutGuideBody}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12.5"
                                           TextWrapping="Wrap"
                                           LineHeight="20"
                                           Margin="0,0,0,12"/>

                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource AboutExampleTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource AboutExampleBody}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12"
                                                   Margin="0,6,0,10"
                                                   TextWrapping="Wrap"
                                                   LineHeight="18"/>
                                        <TextBox x:Name="LayoutSampleBox"
                                                 Style="{StaticResource NoteTextBox}"
                                                 Height="168"
                                                 IsReadOnly="True"
                                                 IsReadOnlyCaretVisible="True"
                                                 FontFamily="Cascadia Mono, Consolas"
                                                 FontSize="12"
                                                 FlowDirection="LeftToRight"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"/>
                                        <Button Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left"
                                                Margin="0,10,0,0"
                                                Click="CopyLayoutSample_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{DynamicResource AboutCopySample}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,12,0,0">
                        <Ellipse x:Name="StatusDot"
                                 Width="8"
                                 Height="8"
                                 Fill="{DynamicResource StatusOkBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText"
                                   Text="{DynamicResource StatusReady}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- Right rail -->
                <Grid Grid.Column="2" Margin="4,16,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="RailGap" Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,14"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <Border Width="48" Height="48" CornerRadius="12" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#5B8CFF" Offset="0"/>
                                        <GradientStop Color="#7A5CFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="16" Height="16">
                                        <Rectangle Canvas.Left="0.5" Canvas.Top="0.5" Width="8.5" Height="8.5"
                                                   RadiusX="1.6" RadiusY="1.6" Fill="White"/>
                                        <Rectangle Canvas.Left="6" Canvas.Top="6" Width="9.2" Height="9.2"
                                                   RadiusX="1.8" RadiusY="1.8"
                                                   Stroke="White" StrokeThickness="1.35" Fill="#33FFFFFF"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="TypeFix"
                                       FontSize="16"
                                       FontWeight="ExtraBold"
                                       Margin="0,10,0,0"/>
                            <TextBlock Text="{DynamicResource Subtitle}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,2,0,8"/>
                            
                            <TextBlock x:Name="VersionText"
                                        Text="v1.0.0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource AccentBrushLight}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource RailQuickInfo}"
                                           FontWeight="SemiBold"
                                           FontSize="13.5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource RailQuickBody}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>
                            <TextBlock Text="{DynamicResource RailQuickHint}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#xE71B;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource RailLinks}"
                                           FontWeight="SemiBold"
                                           FontSize="13.5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="#1A2740">
                                    <TextBlock Text="&#xE774;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrushLight}"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Margin="10,0,8,0"
                                           Text="{DynamicResource RailWebsite}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource LinkBrush}"
                                           Cursor="Hand"
                                           VerticalAlignment="Center"
                                           MouseLeftButtonDown="WebsiteText_MouseLeftButtonDown"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="{DynamicResource TooltipCopyWebsite}"
                                        Click="CopyWebsite_Click"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8C8;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="#1A2740">
                                    <Viewbox Width="14" Height="14">
                                        <Path Fill="{DynamicResource AccentBrushLight}"
                                              Data="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
                                    </Viewbox>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Margin="10,0,8,0"
                                           Text="GitHub"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource LinkBrush}"
                                           Cursor="Hand"
                                           VerticalAlignment="Center"
                                           MouseLeftButtonDown="ContactText_MouseLeftButtonDown"/>
                                <Button Grid.Column="2"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="{DynamicResource TooltipCopyGitHub}"
                                        Click="CopyContact_Click"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8C8;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="4"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Click="SupportCard_Click"
                            ToolTip="{DynamicResource TooltipDonate}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="14" Padding="14,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2457E8" Offset="0"/>
                                            <GradientStop Color="#5B3FD4" Offset="0.6"/>
                                            <GradientStop Color="#6D28D9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="10" Background="#33FFFFFF">
                                            <TextBlock Text="&#xEB51;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource RailSupportTitle}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="White"/>
                                            <TextBlock Text="{DynamicResource RailSupportBody}"
                                                       FontSize="11.5"
                                                       Foreground="#E4E0FF"
                                                       TextWrapping="Wrap"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="&#xE76C;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Border>

        <Grid x:Name="ResizeChrome">
            <Rectangle Width="8" HorizontalAlignment="Left" Cursor="SizeWE" Fill="Transparent"
                       MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown" Tag="Left"/>
            <Rectangle Width="8" HorizontalAlignment="Right" Cursor="SizeWE" Fill="Transparent"
                       MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown" Tag="Right"/>
            <Rectangle Height="8" VerticalAlignment="Top" Cursor="SizeNS" Fill="Transparent"
                       MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown" Tag="Top"/>
            <Rectangle Height="8" VerticalAlignment="Bottom" Cursor="SizeNS" Fill="Transparent"
                       MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown" Tag="Bottom"/>
            <Rectangle Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Fill="Transparent"
                       MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown" Tag="TopLeft"/>
            <Rectangle Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Fill="Transparent"
                       MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown" Tag="TopRight"/>
            <Rectangle Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Fill="Transparent"
                       MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown" Tag="BottomLeft"/>
            <Rectangle Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Fill="Transparent"
                       MouseLeftButtonDown="ResizeEdge_MouseLeftButtonDown" Tag="BottomRight"/>
        </Grid>
    </Grid>
</Window>
