<UserControl x:Class="TypeFix.LayoutManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource LayoutActiveCaption}"
                               FontWeight="SemiBold"
                               FontSize="13.5"/>
                    <TextBlock Text="{DynamicResource LayoutActiveHint}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <ComboBox x:Name="LayoutCombo"
                          Grid.Column="1"
                          Style="{StaticResource DarkComboBox}"
                          MinWidth="220"
                          VerticalAlignment="Center"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Id"
                          SelectionChanged="LayoutCombo_SelectionChanged"/>
            </Grid>
        </Border>

        <StackPanel x:Name="ManagementRoot" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}"
                        Margin="0,0,10,0"
                        ToolTip="{DynamicResource TooltipImportLayout}"
                        Click="ImportButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="White"/>
                        <TextBlock Text="{DynamicResource LayoutImport}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}"
                        ToolTip="{DynamicResource TooltipExportLayouts}"
                        Click="ExportButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource LayoutExportAll}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Text="{DynamicResource LayoutFileHint}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="2,10,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
